packages:
 .

allow-newer: base

source-repository-package
    type: git
    location: https://github.com/diku-dk/futhark.git
    tag: 16c6e619d1cc1a0fc2497a3da4573a89209ae0b9
    -- This flag requires GHC 9.12.
    post-checkout-command: sed -i s/-fexpose-overloaded-unfoldings// futhark.cabal

jobs: $ncpus
