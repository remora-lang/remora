    ;; --- s5: CSP x4, 38 -> 19, 512 -> 1024 channels (feeds P5) ---
    (@uw _ (1024 512 2)) (@u1 _ (1024)) (@u1 _ (1024)) (@u1 _ (1024)) (@u1 _ (1024))  ;; s5-down: 2x2/2 downsample
