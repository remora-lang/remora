    (@uw _ (128 256 1)) (@u1 _ (128)) (@u1 _ (128)) (@u1 _ (128)) (@u1 _ (128))  ;; s4-r5-r: res block 5: 1x1 reduce
    (@uw _ (256 128 3)) (@u1 _ (256)) (@u1 _ (256)) (@u1 _ (256)) (@u1 _ (256))  ;; s4-r5-e: res block 5: 3x3 expand
