;; ----------------- ENTRY -------------------------
;; The only place placeholders are built: @uw for a conv kernel, @u1 for a
;; per-channel batchnorm array. One line per conv+bn layer, in the same
;; order as @yolov4-backbone-neck's parameter list.

(def (fun (@u1 _ ($c) : [Float $c]) (@undefined (Float) ([$c]))))

(def (fun (@uw _ ($o $i $k) : [Float $o $i $k $k]) (@undefined (Float) ([$o $i $k $k]))))

(entry (main)
  (@yolov4-backbone-neck _ ()
    (@undefined (Float) ([3 608 608]))  ;; input image

    ;; --- stem: 3x3 conv at full 608x608 resolution, 3 -> 32 channels ---
    (@uw _ (32 3 3)) (@u1 _ (32)) (@u1 _ (32)) (@u1 _ (32)) (@u1 _ (32))  ;; stem: 3x3 stem conv

    ;; --- s1: CSP x1, 608 -> 304, 32 -> 64 channels ---
    (@uw _ (64 32 2)) (@u1 _ (64)) (@u1 _ (64)) (@u1 _ (64)) (@u1 _ (64))  ;; s1-down: 2x2/2 downsample
    (@uw _ (32 64 1)) (@u1 _ (32)) (@u1 _ (32)) (@u1 _ (32)) (@u1 _ (32))  ;; s1-skip: CSP skip path 1x1
    (@uw _ (32 64 1)) (@u1 _ (32)) (@u1 _ (32)) (@u1 _ (32)) (@u1 _ (32))  ;; s1-m0: CSP main path 1x1
