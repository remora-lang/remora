;; ----------------- UTILITIES -------------------------

(def (fun (@replicate (&t) (@f @s) (in [&t @s]) : [&t @f @s])
    ((array [] (fn ((x [Int])) in)) (i-app iota/static [@f]))))

(def (fun (@pad/2 (&t) ($n $p) (in [&t $n $n])
                            (zero [&t]) : [&t (+ $n $p $p) (+ $n $p $p)])
    (let ((val (vert-pad : [&t $p (+ $p $p $n)]) (@replicate (&t) ([$p (+ $p $p $n)] []) zero))
          (val (hor-pad : [&t $p]) (@replicate (&t) ([$p] []) zero)))
      (@append (&t) ($p (+ $n $p) [(+ $p $p $n)])
         vert-pad
         (@append (&t) ($n $p [(+ $p $p $n)])
           (@append (&t) ($p (+ $n $p) []) hor-pad (@append (&t) ($n $p []) in hor-pad))
           vert-pad)))))

(def (i-fun (idxs-of/2 ($m $n) : [Int $m $n 2])
     ((fn ((i [Int]))
        ((fn ((j [Int])) [i j]) (i-app iota/static [$n])))
      (i-app iota/static [$m]))))

(def (fun (@subarray/2 (&t) ($in-out $m $s)
                    (in [&t (+ $in-out (* $m $s) 1) (+ $in-out (* $m $s) 1)])
                    (offset [Int 2]) : [&t (+ $m 1) (+ $m 1)])
     (@index2d (&t) ((+ $in-out (* $m $s) 1) (+ $in-out (* $m $s) 1))
                    in
                     (+ (@replicate (Int) ([(+ $m 1) (+ $m 1)] [2]) offset)
                        (* (@reify-dim _ ($s)) (i-app idxs-of/2 (+ $m 1) (+ $m 1)))))))

(def (fun (@lifted-subarray/2 (&t) (@shape $in-out $m $s)
                        (in [&t (+ $in-out (* $m $s) 1) (+ $in-out (* $m $s) 1)])
                        (offset [Int @shape 2]) : [&t @shape (+ $m 1) (+ $m 1)])
     (@subarray/2 (&t) ($in-out $m $s) in offset)))

;; ----------------- 4D TRANSPOSE (axes 0 1 2 3 -> 0 2 1 3) -------------------------

(def (fun (@transpose4d/0213 (&t) ($a $b $c $d)
                (in [&t $a $b $c $d])
                : [&t $a $c $b $d])
    (let ((val (flat-cd : [&t $a $b (* $c $d)])
               (@flatten (&t) ($c $d []) in))
          (val (swapped : [&t $a (* $c $d) $b])
               (@transpose2d (&t) ($b (* $c $d)) flat-cd))
          (val (split-cd : [&t $a $c $d $b])
               (@reshape (&t) ([$a (* $c $d) $b] [$a $c $d $b]) swapped)))
      (@transpose2d (&t) ($d $b) split-cd))))

;; ----------------- CONVOLUTION -------------------------
;; Models darknet's truncating output-size division: writing
;;   n + 2*pad - k = $q * $s + $r
;; gives out = $q + 1 and leaves $r padded cells no window reads. Instead of
;; constraining $n, this derives it, which is exact for every (n, pad, k, s):
;;   n = $q * $s + $k + $r - 2 * $pad
;; $pad is a plain per-side pixel count, not pre-divided by the stride.
;;
;; PRECONDITION: $r < $s. This is what makes $q the true floor quotient, i.e.
;;   $q + 1 == (n + 2*$pad - $k)/$s + 1 as darknet computes it. Nothing checks
;;   it; an $r >= $s silently describes a larger input than darknet would pick
;;   for the same $q, shifting every output position.
;; Also implicitly required, and equally unchecked:
;;   - $s >= 1 and $k >= 1; $q, $r, $pad >= 0.
;;   - (* $q $s) + $k + $r > $pad + $pad, so the derived input size is
;;     positive. Dim evaluation rejects a negative result, but only at the
;;     point the shape is used.
;;   - $in-c >= 1 and $out-c >= 1 (@dot needs $k*$k*$in-c >= 1).
;;   - the input is square; only one spatial size is tracked.
;;   - $pad < $k for the result to mean anything: a larger pad admits windows
;;     lying entirely in padding, which darknet's pad=size/2 never produces.

(def (fun (@im2col/rem _ ($q $k $pad $in-c $s $r)
                  (im [Float $in-c (- (+ (* $q $s) $k $r) $pad $pad) (- (+ (* $q $s) $k $r) $pad $pad)])
                  : [Float (* $in-c $k $k) (* (+ $q 1) (+ $q 1))])
      (@flatten (Float) ($in-c (* $k $k) [(* (+ $q 1) (+ $q 1))])
        (@flatten (Float) ($k $k [(* (+ $q 1) (+ $q 1))])
          (@flatten (Float) ((+ $q 1) (+ $q 1) [])
             (@lifted-subarray/2 (Float) ([$k $k] (- (+ $k $r) 1) $q $s)
               (@pad/2 (Float) ((- (+ (* $q $s) $k $r) $pad $pad) $pad) im 0.0)
                 (@replicate (Int) ([$in-c] [$k $k 2])
                   (i-app idxs-of/2 $k $k))))))))

(def (fun (@dot _ ($n-1) (v [Float (+ 1 $n-1)]) (w [Float (+ 1 $n-1)]) : [Float])
    (@reduce (Float) ($n-1 []) f.+ (f.* v w))))

(def (fun (@lifted_dot _ ($m-1 $o) (v [Float (+ 1 $m-1)]) (M [Float (+ 1 $m-1) $o]) : [Float $o])
    (@dot _ ($m-1) v (@transpose2d (Float) ((+ 1 $m-1) $o) M))))

(def (fun (@matmul _ ($n $m-1 $o) (xss [Float $n (+ 1 $m-1)])
                               (yss [Float (+ 1 $m-1) $o]) : [Float $n $o])
      (@lifted_dot _ ($m-1 $o) xss yss)))

(def (fun (@conv-2d/rem _ ($q $k $in-c $out-c $pad $s $r)
                (in [Float $in-c (- (+ (* $q $s) $k $r) $pad $pad) (- (+ (* $q $s) $k $r) $pad $pad)])
                (w  [Float $out-c $in-c $k $k])
                : [Float $out-c (* (+ $q 1) (+ $q 1))])
    (@matmul _ ($out-c (- (* $k $k $in-c) 1) (* (+ $q 1) (+ $q 1)))
             (@flatten (Float) ($in-c (* $k $k) [])
                (@flatten (Float) ($k $k []) w))
             (@im2col/rem _ ($q $k $pad $in-c $s $r) in))))

;; ----------------- MAX POOLING -------------------------

(def (fun (@f-max2d _ (@s) (a [Float @s]) (b [Float @s]) : [Float @s])
     (f.max a b)))

(def (fun (@max-pool-2d _ ($n-k $k $in-c $p $s)
                (in [Float $in-c (+ (* $n-k $s) $k) (+ (* $n-k $s) $k)])
                : [Float $in-c (+ $n-k $p $p 1) (+ $n-k $p $p 1)])
    (@reduce (Float) ((- $k 1) [(+ $n-k $p $p 1) (+ $n-k $p $p 1)])
             (@f-max2d _ ([(+ $n-k $p $p 1) (+ $n-k $p $p 1)]))
      (@reduce (Float) ((- $k 1) [$k (+ $n-k $p $p 1) (+ $n-k $p $p 1)])
               (@f-max2d _ ([$k (+ $n-k $p $p 1) (+ $n-k $p $p 1)]))
        (@lifted-subarray/2 (Float) ([$k $k] (- $k 1) (+ $n-k $p $p) $s)
          (@pad/2 (Float) ((+ (* $n-k $s) $k) (* $p $s)) in -1.0e30)
            (@replicate (Int) ([$in-c] [$k $k 2])
              (i-app idxs-of/2 $k $k)))))))

;; ----------------- BATCH NORMALIZATION -------------------------

(def (fun (@batch-norm-2d-apply _ ($n $k)
                (in [Float $k $n $n])
                (mean [Float $k])
                (variance [Float $k])
                (scale [Float $k])
                (bias [Float $k])
                : [Float $k $n $n])
    (f.+ (f.* (f./ (f.- in (@replicate (Float) ([$n $n] []) mean))
                   (f.sqrt (@replicate (Float) ([$n $n] []) (f.+ variance 0.00001))))
              (@replicate (Float) ([$n $n] []) scale))
         (@replicate (Float) ([$n $n] []) bias))))

;; ----------------- ACTIVATIONS -------------------------

(def (fun (@leaky-relu _ () (x [Float]) : [Float])
    (f.max x (f.* 0.1 x))))

(def (val e 2.718281828459045))

(def (fun (@softplus _ () (x [Float]) : [Float])
     (f.ln (f.+ 1.0 (f.^ e x)))))

(def (fun (@mish _ () (x [Float]) : [Float])
     (f.* x (f.tanh (@softplus _ () x)))))

;; ----------------- NEAREST NEIGHBOR UPSAMPLING -------------------------

(def (fun (@upsample-nearest _ ($n $k $s)
                (in [Float $k $n $n])
                : [Float $k (* $n $s) (* $n $s)])
    (let ((val (replicated : [Float $k $n $n $s $s])
               (@replicate (Float) ([$s $s] []) in))
          (val (transposed : [Float $k $n $s $n $s])
               (@transpose4d/0213 (Float) ($n $n $s $s) replicated))
          (val (merged-rows : [Float $k (* $n $s) $n $s])
               (@flatten (Float) ($n $s [$n $s]) transposed)))
      (@flatten (Float) ($n $s []) merged-rows))))

;; ----------------- SHORTCUT / ROUTE / SPP -------------------------

(def (fun (@shortcut _ () (a [Float]) (b [Float]) : [Float])
    (f.+ a b)))

(def (fun (@route2 _ ($c1 $c2 $h $w)
                (a [Float $c1 $h $w])
                (b [Float $c2 $h $w])
                : [Float (+ $c1 $c2) $h $w])
     (@append (Float) ($c1 $c2 [$h $w]) a b)))

(def (fun (@spp _ ($n $k)
                (in [Float $k $n $n])
                : [Float (* 4 $k) $n $n])
    (let ((type *map [Float $k $n $n])
          (val (mp5  : *map) (@max-pool-2d _ ((- $n 5) 5 $k 2 1) in))
          (val (mp9  : *map) (@max-pool-2d _ ((- $n 9) 9 $k 4 1) in))
          (val (mp13 : *map) (@max-pool-2d _ ((- $n 13) 13 $k 6 1) in)))
      (@append (Float) ($k (* 3 $k) [$n $n])
         mp13
         (@append (Float) ($k (* 2 $k) [$n $n])
            mp9
            (@append (Float) ($k $k [$n $n]) mp5 in))))))

;; ----------------- CONV + BATCHNORM + ACTIVATION -------------------------
;; One record per conv+bn layer holds all five learnable tensors: the conv
;; kernel plus batchnorm's per-channel mean/variance/scale/bias. At inference
;; batchnorm uses a trained checkpoint's stored running stats, not anything
;; recomputed from this call's input (see batch_norm.remora).

(def (fun (@undef-params _ ($o $i $k) : {(w [Float $o $i $k $k]) (mean [Float $o]) (variance [Float $o]) (scale [Float $o]) (bias [Float $o])})
    {(w [$o $i $k $k] (@undefined (Float) ([$o $i $k $k])))
     (mean [$o] (@undefined (Float) ([$o])))
     (variance [$o] (@undefined (Float) ([$o])))
     (scale [$o] (@undefined (Float) ([$o])))
     (bias [$o] (@undefined (Float) ([$o])))}))

(def (fun (@conv-bn-mish _ ($q $k $in-c $out-c $pad $s $r)
                (in [Float $in-c (- (+ (* $q $s) $k $r) $pad $pad) (- (+ (* $q $s) $k $r) $pad $pad)])
                (p {(w [Float $out-c $in-c $k $k]) (mean [Float $out-c]) (variance [Float $out-c]) (scale [Float $out-c]) (bias [Float $out-c])})
                : [Float $out-c (+ $q 1) (+ $q 1)])
    (let ((val (conv-out : [Float $out-c (+ $q 1) (+ $q 1)])
               (@reshape (Float) ([$out-c (* (+ $q 1) (+ $q 1))] [$out-c (+ $q 1) (+ $q 1)])
                  (@conv-2d/rem _ ($q $k $in-c $out-c $pad $s $r) in (field p w)))))
      (@mish _ ()
        (@batch-norm-2d-apply _ ((+ $q 1) $out-c) conv-out
          (field p mean) (field p variance) (field p scale) (field p bias))))))

(def (fun (@conv-bn-leaky _ ($q $k $in-c $out-c $pad $s $r)
                (in [Float $in-c (- (+ (* $q $s) $k $r) $pad $pad) (- (+ (* $q $s) $k $r) $pad $pad)])
                (p {(w [Float $out-c $in-c $k $k]) (mean [Float $out-c]) (variance [Float $out-c]) (scale [Float $out-c]) (bias [Float $out-c])})
                : [Float $out-c (+ $q 1) (+ $q 1)])
    (let ((val (conv-out : [Float $out-c (+ $q 1) (+ $q 1)])
               (@reshape (Float) ([$out-c (* (+ $q 1) (+ $q 1))] [$out-c (+ $q 1) (+ $q 1)])
                  (@conv-2d/rem _ ($q $k $in-c $out-c $pad $s $r) in (field p w)))))
      (@leaky-relu _ ()
        (@batch-norm-2d-apply _ ((+ $q 1) $out-c) conv-out
          (field p mean) (field p variance) (field p scale) (field p bias))))))

;; ----------------- CSPDARKNET53 RESIDUAL BLOCK -------------------------
;; Both convs are stride 1 and size-preserving, so $q = $n - 1 and $r = 0:
;; 1x1 with pad 0 and 3x3 with pad 1 both leave the spatial size at $n.

(def (fun (@res-block _ ($h $h2 $n)
                (in [Float $h $n $n])
                (rp {(w [Float $h2 $h 1 1]) (mean [Float $h2]) (variance [Float $h2]) (scale [Float $h2]) (bias [Float $h2])})
                (ep {(w [Float $h $h2 3 3]) (mean [Float $h]) (variance [Float $h]) (scale [Float $h]) (bias [Float $h])})
                : [Float $h $n $n])
    (let ((val (reduced : [Float $h2 $n $n])
               (@conv-bn-mish _ ((- $n 1) 1 $h $h2 0 1 0) in rp))
          (val (expanded : [Float $h $n $n])
               (@conv-bn-mish _ ((- $n 1) 3 $h2 $h 1 1 0) reduced ep)))
      (@shortcut _ () expanded in))))

;; ----------------- CSP STAGES -------------------------
;; Downsample with darknet's real 3x3 / stride 2 / pad 1, then CSP split into
;; two 1x1-conv paths (skip + main), N residual blocks on the main path, a 1x1
;; conv, concat, and a 1x1 transition conv. $n-k-down is the downsample's $q,
;; so the post-downsample spatial size is (+ $n-k-down 1) and the stage input
;; is (+ (* $n-k-down 2) 2): for an even input N, N/2 - 1 windows of a 3x3 at
;; stride 2 over N+2 padded columns leaves remainder $r = 1.

(def (fun (@csp-stage-x1 _ ($in-ch $half $quarter $n-k-down)
                (in [Float $in-ch (+ (* $n-k-down 2) 2) (+ (* $n-k-down 2) 2)])
                (down-p {(w [Float (+ $half $half) $in-ch 3 3]) (mean [Float (+ $half $half)]) (variance [Float (+ $half $half)]) (scale [Float (+ $half $half)]) (bias [Float (+ $half $half)])})  ;; 3x3/stride-2/pad-1 downsample
                (skip-p {(w [Float $half (+ $half $half) 1 1]) (mean [Float $half]) (variance [Float $half]) (scale [Float $half]) (bias [Float $half])})  ;; CSP skip path
                (m0-p {(w [Float $half (+ $half $half) 1 1]) (mean [Float $half]) (variance [Float $half]) (scale [Float $half]) (bias [Float $half])})  ;; CSP main path
                (r1-rp {(w [Float $quarter $half 1 1]) (mean [Float $quarter]) (variance [Float $quarter]) (scale [Float $quarter]) (bias [Float $quarter])})  ;; residual block 1 reduce
                (r1-ep {(w [Float $half $quarter 3 3]) (mean [Float $half]) (variance [Float $half]) (scale [Float $half]) (bias [Float $half])})  ;; residual block 1 expand
                (mf-p {(w [Float $half $half 1 1]) (mean [Float $half]) (variance [Float $half]) (scale [Float $half]) (bias [Float $half])})  ;; main path final 1x1
                (tr-p {(w [Float (+ $half $half) (+ $half $half) 1 1]) (mean [Float (+ $half $half)]) (variance [Float (+ $half $half)]) (scale [Float (+ $half $half)]) (bias [Float (+ $half $half)])})  ;; transition after concat
                : [Float (+ $half $half) (+ $n-k-down 1) (+ $n-k-down 1)])
    (let ((type *full-map [Float (+ $half $half) (+ $n-k-down 1) (+ $n-k-down 1)])
          (type *half-map [Float $half (+ $n-k-down 1) (+ $n-k-down 1)])
          (val (down  : *full-map)
               (@conv-bn-mish _ ($n-k-down 3 $in-ch (+ $half $half) 1 2 1) in down-p))
          (val (skip  : *half-map)
               (@conv-bn-mish _ ($n-k-down 1 (+ $half $half) $half 0 1 0) down skip-p))
          (val (main0 : *half-map)
               (@conv-bn-mish _ ($n-k-down 1 (+ $half $half) $half 0 1 0) down m0-p))
          (val (main1 : *half-map)
               (@res-block _ ($half $quarter (+ $n-k-down 1)) main0 r1-rp r1-ep))
          (val (mainF : *half-map)
               (@conv-bn-mish _ ($n-k-down 1 $half $half 0 1 0) main1 mf-p))
          (val (merged : *full-map)
               (@route2 _ ($half $half (+ $n-k-down 1) (+ $n-k-down 1)) mainF skip)))
      (@conv-bn-mish _ ($n-k-down 1 (+ $half $half) (+ $half $half) 0 1 0) merged tr-p))))

(def (fun (@csp-stage-x2 _ ($in-ch $half $quarter $n-k-down)
                (in [Float $in-ch (+ (* $n-k-down 2) 2) (+ (* $n-k-down 2) 2)])
                (down-p {(w [Float (+ $half $half) $in-ch 3 3]) (mean [Float (+ $half $half)]) (variance [Float (+ $half $half)]) (scale [Float (+ $half $half)]) (bias [Float (+ $half $half)])})  ;; 3x3/stride-2/pad-1 downsample
                (skip-p {(w [Float $half (+ $half $half) 1 1]) (mean [Float $half]) (variance [Float $half]) (scale [Float $half]) (bias [Float $half])})  ;; CSP skip path
                (m0-p {(w [Float $half (+ $half $half) 1 1]) (mean [Float $half]) (variance [Float $half]) (scale [Float $half]) (bias [Float $half])})  ;; CSP main path
                (r1-rp {(w [Float $quarter $half 1 1]) (mean [Float $quarter]) (variance [Float $quarter]) (scale [Float $quarter]) (bias [Float $quarter])})  ;; residual block 1 reduce
                (r1-ep {(w [Float $half $quarter 3 3]) (mean [Float $half]) (variance [Float $half]) (scale [Float $half]) (bias [Float $half])})  ;; residual block 1 expand
                (r2-rp {(w [Float $quarter $half 1 1]) (mean [Float $quarter]) (variance [Float $quarter]) (scale [Float $quarter]) (bias [Float $quarter])})  ;; residual block 2 reduce
                (r2-ep {(w [Float $half $quarter 3 3]) (mean [Float $half]) (variance [Float $half]) (scale [Float $half]) (bias [Float $half])})  ;; residual block 2 expand
                (mf-p {(w [Float $half $half 1 1]) (mean [Float $half]) (variance [Float $half]) (scale [Float $half]) (bias [Float $half])})  ;; main path final 1x1
                (tr-p {(w [Float (+ $half $half) (+ $half $half) 1 1]) (mean [Float (+ $half $half)]) (variance [Float (+ $half $half)]) (scale [Float (+ $half $half)]) (bias [Float (+ $half $half)])})  ;; transition after concat
                : [Float (+ $half $half) (+ $n-k-down 1) (+ $n-k-down 1)])
    (let ((type *full-map [Float (+ $half $half) (+ $n-k-down 1) (+ $n-k-down 1)])
          (type *half-map [Float $half (+ $n-k-down 1) (+ $n-k-down 1)])
          (val (down  : *full-map)
               (@conv-bn-mish _ ($n-k-down 3 $in-ch (+ $half $half) 1 2 1) in down-p))
          (val (skip  : *half-map)
               (@conv-bn-mish _ ($n-k-down 1 (+ $half $half) $half 0 1 0) down skip-p))
          (val (main0 : *half-map)
               (@conv-bn-mish _ ($n-k-down 1 (+ $half $half) $half 0 1 0) down m0-p))
          (val (main1 : *half-map)
               (@res-block _ ($half $quarter (+ $n-k-down 1)) main0 r1-rp r1-ep))
          (val (main2 : *half-map)
               (@res-block _ ($half $quarter (+ $n-k-down 1)) main1 r2-rp r2-ep))
          (val (mainF : *half-map)
               (@conv-bn-mish _ ($n-k-down 1 $half $half 0 1 0) main2 mf-p))
          (val (merged : *full-map)
               (@route2 _ ($half $half (+ $n-k-down 1) (+ $n-k-down 1)) mainF skip)))
      (@conv-bn-mish _ ($n-k-down 1 (+ $half $half) (+ $half $half) 0 1 0) merged tr-p))))

(def (fun (@csp-stage-x4 _ ($in-ch $half $quarter $n-k-down)
                (in [Float $in-ch (+ (* $n-k-down 2) 2) (+ (* $n-k-down 2) 2)])
                (down-p {(w [Float (+ $half $half) $in-ch 3 3]) (mean [Float (+ $half $half)]) (variance [Float (+ $half $half)]) (scale [Float (+ $half $half)]) (bias [Float (+ $half $half)])})  ;; 3x3/stride-2/pad-1 downsample
                (skip-p {(w [Float $half (+ $half $half) 1 1]) (mean [Float $half]) (variance [Float $half]) (scale [Float $half]) (bias [Float $half])})  ;; CSP skip path
                (m0-p {(w [Float $half (+ $half $half) 1 1]) (mean [Float $half]) (variance [Float $half]) (scale [Float $half]) (bias [Float $half])})  ;; CSP main path
                (r1-rp {(w [Float $quarter $half 1 1]) (mean [Float $quarter]) (variance [Float $quarter]) (scale [Float $quarter]) (bias [Float $quarter])})  ;; residual block 1 reduce
                (r1-ep {(w [Float $half $quarter 3 3]) (mean [Float $half]) (variance [Float $half]) (scale [Float $half]) (bias [Float $half])})  ;; residual block 1 expand
                (r2-rp {(w [Float $quarter $half 1 1]) (mean [Float $quarter]) (variance [Float $quarter]) (scale [Float $quarter]) (bias [Float $quarter])})  ;; residual block 2 reduce
                (r2-ep {(w [Float $half $quarter 3 3]) (mean [Float $half]) (variance [Float $half]) (scale [Float $half]) (bias [Float $half])})  ;; residual block 2 expand
                (r3-rp {(w [Float $quarter $half 1 1]) (mean [Float $quarter]) (variance [Float $quarter]) (scale [Float $quarter]) (bias [Float $quarter])})  ;; residual block 3 reduce
                (r3-ep {(w [Float $half $quarter 3 3]) (mean [Float $half]) (variance [Float $half]) (scale [Float $half]) (bias [Float $half])})  ;; residual block 3 expand
                (r4-rp {(w [Float $quarter $half 1 1]) (mean [Float $quarter]) (variance [Float $quarter]) (scale [Float $quarter]) (bias [Float $quarter])})  ;; residual block 4 reduce
                (r4-ep {(w [Float $half $quarter 3 3]) (mean [Float $half]) (variance [Float $half]) (scale [Float $half]) (bias [Float $half])})  ;; residual block 4 expand
                (mf-p {(w [Float $half $half 1 1]) (mean [Float $half]) (variance [Float $half]) (scale [Float $half]) (bias [Float $half])})  ;; main path final 1x1
                (tr-p {(w [Float (+ $half $half) (+ $half $half) 1 1]) (mean [Float (+ $half $half)]) (variance [Float (+ $half $half)]) (scale [Float (+ $half $half)]) (bias [Float (+ $half $half)])})  ;; transition after concat
                : [Float (+ $half $half) (+ $n-k-down 1) (+ $n-k-down 1)])
    (let ((type *full-map [Float (+ $half $half) (+ $n-k-down 1) (+ $n-k-down 1)])
          (type *half-map [Float $half (+ $n-k-down 1) (+ $n-k-down 1)])
          (val (down  : *full-map)
               (@conv-bn-mish _ ($n-k-down 3 $in-ch (+ $half $half) 1 2 1) in down-p))
          (val (skip  : *half-map)
               (@conv-bn-mish _ ($n-k-down 1 (+ $half $half) $half 0 1 0) down skip-p))
          (val (main0 : *half-map)
               (@conv-bn-mish _ ($n-k-down 1 (+ $half $half) $half 0 1 0) down m0-p))
          (val (main1 : *half-map)
               (@res-block _ ($half $quarter (+ $n-k-down 1)) main0 r1-rp r1-ep))
          (val (main2 : *half-map)
               (@res-block _ ($half $quarter (+ $n-k-down 1)) main1 r2-rp r2-ep))
          (val (main3 : *half-map)
               (@res-block _ ($half $quarter (+ $n-k-down 1)) main2 r3-rp r3-ep))
          (val (main4 : *half-map)
               (@res-block _ ($half $quarter (+ $n-k-down 1)) main3 r4-rp r4-ep))
          (val (mainF : *half-map)
               (@conv-bn-mish _ ($n-k-down 1 $half $half 0 1 0) main4 mf-p))
          (val (merged : *full-map)
               (@route2 _ ($half $half (+ $n-k-down 1) (+ $n-k-down 1)) mainF skip)))
      (@conv-bn-mish _ ($n-k-down 1 (+ $half $half) (+ $half $half) 0 1 0) merged tr-p))))

(def (fun (@csp-stage-x8 _ ($in-ch $half $quarter $n-k-down)
                (in [Float $in-ch (+ (* $n-k-down 2) 2) (+ (* $n-k-down 2) 2)])
                (down-p {(w [Float (+ $half $half) $in-ch 3 3]) (mean [Float (+ $half $half)]) (variance [Float (+ $half $half)]) (scale [Float (+ $half $half)]) (bias [Float (+ $half $half)])})  ;; 3x3/stride-2/pad-1 downsample
                (skip-p {(w [Float $half (+ $half $half) 1 1]) (mean [Float $half]) (variance [Float $half]) (scale [Float $half]) (bias [Float $half])})  ;; CSP skip path
                (m0-p {(w [Float $half (+ $half $half) 1 1]) (mean [Float $half]) (variance [Float $half]) (scale [Float $half]) (bias [Float $half])})  ;; CSP main path
                (r1-rp {(w [Float $quarter $half 1 1]) (mean [Float $quarter]) (variance [Float $quarter]) (scale [Float $quarter]) (bias [Float $quarter])})  ;; residual block 1 reduce
                (r1-ep {(w [Float $half $quarter 3 3]) (mean [Float $half]) (variance [Float $half]) (scale [Float $half]) (bias [Float $half])})  ;; residual block 1 expand
                (r2-rp {(w [Float $quarter $half 1 1]) (mean [Float $quarter]) (variance [Float $quarter]) (scale [Float $quarter]) (bias [Float $quarter])})  ;; residual block 2 reduce
                (r2-ep {(w [Float $half $quarter 3 3]) (mean [Float $half]) (variance [Float $half]) (scale [Float $half]) (bias [Float $half])})  ;; residual block 2 expand
                (r3-rp {(w [Float $quarter $half 1 1]) (mean [Float $quarter]) (variance [Float $quarter]) (scale [Float $quarter]) (bias [Float $quarter])})  ;; residual block 3 reduce
                (r3-ep {(w [Float $half $quarter 3 3]) (mean [Float $half]) (variance [Float $half]) (scale [Float $half]) (bias [Float $half])})  ;; residual block 3 expand
                (r4-rp {(w [Float $quarter $half 1 1]) (mean [Float $quarter]) (variance [Float $quarter]) (scale [Float $quarter]) (bias [Float $quarter])})  ;; residual block 4 reduce
                (r4-ep {(w [Float $half $quarter 3 3]) (mean [Float $half]) (variance [Float $half]) (scale [Float $half]) (bias [Float $half])})  ;; residual block 4 expand
                (r5-rp {(w [Float $quarter $half 1 1]) (mean [Float $quarter]) (variance [Float $quarter]) (scale [Float $quarter]) (bias [Float $quarter])})  ;; residual block 5 reduce
                (r5-ep {(w [Float $half $quarter 3 3]) (mean [Float $half]) (variance [Float $half]) (scale [Float $half]) (bias [Float $half])})  ;; residual block 5 expand
                (r6-rp {(w [Float $quarter $half 1 1]) (mean [Float $quarter]) (variance [Float $quarter]) (scale [Float $quarter]) (bias [Float $quarter])})  ;; residual block 6 reduce
                (r6-ep {(w [Float $half $quarter 3 3]) (mean [Float $half]) (variance [Float $half]) (scale [Float $half]) (bias [Float $half])})  ;; residual block 6 expand
                (r7-rp {(w [Float $quarter $half 1 1]) (mean [Float $quarter]) (variance [Float $quarter]) (scale [Float $quarter]) (bias [Float $quarter])})  ;; residual block 7 reduce
                (r7-ep {(w [Float $half $quarter 3 3]) (mean [Float $half]) (variance [Float $half]) (scale [Float $half]) (bias [Float $half])})  ;; residual block 7 expand
                (r8-rp {(w [Float $quarter $half 1 1]) (mean [Float $quarter]) (variance [Float $quarter]) (scale [Float $quarter]) (bias [Float $quarter])})  ;; residual block 8 reduce
                (r8-ep {(w [Float $half $quarter 3 3]) (mean [Float $half]) (variance [Float $half]) (scale [Float $half]) (bias [Float $half])})  ;; residual block 8 expand
                (mf-p {(w [Float $half $half 1 1]) (mean [Float $half]) (variance [Float $half]) (scale [Float $half]) (bias [Float $half])})  ;; main path final 1x1
                (tr-p {(w [Float (+ $half $half) (+ $half $half) 1 1]) (mean [Float (+ $half $half)]) (variance [Float (+ $half $half)]) (scale [Float (+ $half $half)]) (bias [Float (+ $half $half)])})  ;; transition after concat
                : [Float (+ $half $half) (+ $n-k-down 1) (+ $n-k-down 1)])
    (let ((type *full-map [Float (+ $half $half) (+ $n-k-down 1) (+ $n-k-down 1)])
          (type *half-map [Float $half (+ $n-k-down 1) (+ $n-k-down 1)])
          (val (down  : *full-map)
               (@conv-bn-mish _ ($n-k-down 3 $in-ch (+ $half $half) 1 2 1) in down-p))
          (val (skip  : *half-map)
               (@conv-bn-mish _ ($n-k-down 1 (+ $half $half) $half 0 1 0) down skip-p))
          (val (main0 : *half-map)
               (@conv-bn-mish _ ($n-k-down 1 (+ $half $half) $half 0 1 0) down m0-p))
          (val (main1 : *half-map)
               (@res-block _ ($half $quarter (+ $n-k-down 1)) main0 r1-rp r1-ep))
          (val (main2 : *half-map)
               (@res-block _ ($half $quarter (+ $n-k-down 1)) main1 r2-rp r2-ep))
          (val (main3 : *half-map)
               (@res-block _ ($half $quarter (+ $n-k-down 1)) main2 r3-rp r3-ep))
          (val (main4 : *half-map)
               (@res-block _ ($half $quarter (+ $n-k-down 1)) main3 r4-rp r4-ep))
          (val (main5 : *half-map)
               (@res-block _ ($half $quarter (+ $n-k-down 1)) main4 r5-rp r5-ep))
          (val (main6 : *half-map)
               (@res-block _ ($half $quarter (+ $n-k-down 1)) main5 r6-rp r6-ep))
          (val (main7 : *half-map)
               (@res-block _ ($half $quarter (+ $n-k-down 1)) main6 r7-rp r7-ep))
          (val (main8 : *half-map)
               (@res-block _ ($half $quarter (+ $n-k-down 1)) main7 r8-rp r8-ep))
          (val (mainF : *half-map)
               (@conv-bn-mish _ ($n-k-down 1 $half $half 0 1 0) main8 mf-p))
          (val (merged : *full-map)
               (@route2 _ ($half $half (+ $n-k-down 1) (+ $n-k-down 1)) mainF skip)))
      (@conv-bn-mish _ ($n-k-down 1 (+ $half $half) (+ $half $half) 0 1 0) merged tr-p))))

;; ----------------- SPP / PANET CONV BLOCKS (leaky) -------------------------

(def (fun (@panet-3conv _ ($in-ch $mid $small $n)
                (in [Float $in-ch $n $n])
                (c1-p {(w [Float $small $in-ch 1 1]) (mean [Float $small]) (variance [Float $small]) (scale [Float $small]) (bias [Float $small])})
                (c2-p {(w [Float $mid $small 3 3]) (mean [Float $mid]) (variance [Float $mid]) (scale [Float $mid]) (bias [Float $mid])})
                (c3-p {(w [Float $small $mid 1 1]) (mean [Float $small]) (variance [Float $small]) (scale [Float $small]) (bias [Float $small])})
                : [Float $small $n $n])
    (let ((val (c1 : [Float $small $n $n]) (@conv-bn-leaky _ ((- $n 1) 1 $in-ch $small 0 1 0) in c1-p))
          (val (c2 : [Float $mid $n $n]) (@conv-bn-leaky _ ((- $n 1) 3 $small $mid 1 1 0) c1 c2-p)))
      (@conv-bn-leaky _ ((- $n 1) 1 $mid $small 0 1 0) c2 c3-p))))

(def (fun (@panet-5conv _ ($big $small $n)
                (in [Float $big $n $n])
                (c1-p {(w [Float $small $big 1 1]) (mean [Float $small]) (variance [Float $small]) (scale [Float $small]) (bias [Float $small])})
                (c2-p {(w [Float $big $small 3 3]) (mean [Float $big]) (variance [Float $big]) (scale [Float $big]) (bias [Float $big])})
                (c3-p {(w [Float $small $big 1 1]) (mean [Float $small]) (variance [Float $small]) (scale [Float $small]) (bias [Float $small])})
                (c4-p {(w [Float $big $small 3 3]) (mean [Float $big]) (variance [Float $big]) (scale [Float $big]) (bias [Float $big])})
                (c5-p {(w [Float $small $big 1 1]) (mean [Float $small]) (variance [Float $small]) (scale [Float $small]) (bias [Float $small])})
                : [Float $small $n $n])
    (let ((type *small-map [Float $small $n $n])
          (type *big-map [Float $big $n $n])
          (val (c1 : *small-map) (@conv-bn-leaky _ ((- $n 1) 1 $big $small 0 1 0) in c1-p))
          (val (c2 : *big-map) (@conv-bn-leaky _ ((- $n 1) 3 $small $big 1 1 0) c1 c2-p))
          (val (c3 : *small-map) (@conv-bn-leaky _ ((- $n 1) 1 $big $small 0 1 0) c2 c3-p))
          (val (c4 : *big-map) (@conv-bn-leaky _ ((- $n 1) 3 $small $big 1 1 0) c3 c4-p)))
      (@conv-bn-leaky _ ((- $n 1) 1 $big $small 0 1 0) c4 c5-p))))

;; ----------------- FULL REDUCTION (combines the 3 differently-shaped outputs) ---

(def (fun (@full-sum _ ($n $c) (in [Float $c $n $n]) : [Float])
    (@reduce (Float) ((- $c 1) []) f.+
      (@reduce (Float) ((- $n 1) []) f.+
        (@reduce (Float) ((- $n 1) []) f.+ in)))))

;; ----------------- FULL NETWORK (CSPDarknet53 + SPP + PANet, no detection heads) ---
;; Input 608x608x3. Backbone stages halve resolution 5 times: 608 -> 304 ->
;; 152 -> 76 -> 38 -> 19 (channels 32 -> 64 -> 128 -> 256 -> 512 -> 1024,
;; block counts 1/2/8/8/4). SPP + PANet then produce 3 feature maps at
;; 76x76x128, 38x38x256 and 19x19x512 -- the inputs the (omitted) detection
;; heads would run on. Each layer's params come from @undef-params: correctly
;; shaped placeholders standing in for a trained checkpoint.

(entry (main)
  (let (
        (type *f128x76 [Float 128 76 76])
        (type *f256x76 [Float 256 76 76])
        (type *f256x38 [Float 256 38 38])
        (type *f512x38 [Float 512 38 38])
        (type *f512x19 [Float 512 19 19])
        (type *f1024x19 [Float 1024 19 19])
        (val image (@undefined (Float) ([3 608 608])))

        ;; --- stem: 3x3 conv at full 608x608, 3 -> 32 channels ---
        (val stem-p (@undef-params _ (32 3 3)))
        (val (stem : [Float 32 608 608]) (@conv-bn-mish _ (607 3 3 32 1 1 0) image stem-p))

        ;; --- s1: CSP x1, 608 -> 304, 32 -> 64 channels ---
        (val s1-down-p (@undef-params _ (64 32 3)))
        (val s1-skip-p (@undef-params _ (32 64 1)))
        (val s1-m0-p (@undef-params _ (32 64 1)))
        (val s1-r1-rp (@undef-params _ (16 32 1)))
        (val s1-r1-ep (@undef-params _ (32 16 3)))
        (val s1-mf-p (@undef-params _ (32 32 1)))
        (val s1-tr-p (@undef-params _ (64 64 1)))
        (val (s1 : [Float 64 304 304])
             (@csp-stage-x1 _ (32 32 16 303) stem
               s1-down-p s1-skip-p s1-m0-p s1-r1-rp s1-r1-ep s1-mf-p s1-tr-p))

        ;; --- s2: CSP x2, 304 -> 152, 64 -> 128 channels ---
        (val s2-down-p (@undef-params _ (128 64 3)))
        (val s2-skip-p (@undef-params _ (64 128 1)))
        (val s2-m0-p (@undef-params _ (64 128 1)))
        (val s2-r1-rp (@undef-params _ (32 64 1)))
        (val s2-r1-ep (@undef-params _ (64 32 3)))
        (val s2-r2-rp (@undef-params _ (32 64 1)))
        (val s2-r2-ep (@undef-params _ (64 32 3)))
        (val s2-mf-p (@undef-params _ (64 64 1)))
        (val s2-tr-p (@undef-params _ (128 128 1)))
        (val (s2 : [Float 128 152 152])
             (@csp-stage-x2 _ (64 64 32 151) s1
               s2-down-p s2-skip-p s2-m0-p s2-r1-rp s2-r1-ep s2-r2-rp s2-r2-ep s2-mf-p s2-tr-p))

        ;; --- s3: CSP x8, 152 -> 76, 128 -> 256 channels (feeds P3) ---
        (val s3-down-p (@undef-params _ (256 128 3)))
        (val s3-skip-p (@undef-params _ (128 256 1)))
        (val s3-m0-p (@undef-params _ (128 256 1)))
        (val s3-r1-rp (@undef-params _ (64 128 1)))
        (val s3-r1-ep (@undef-params _ (128 64 3)))
        (val s3-r2-rp (@undef-params _ (64 128 1)))
        (val s3-r2-ep (@undef-params _ (128 64 3)))
        (val s3-r3-rp (@undef-params _ (64 128 1)))
        (val s3-r3-ep (@undef-params _ (128 64 3)))
        (val s3-r4-rp (@undef-params _ (64 128 1)))
        (val s3-r4-ep (@undef-params _ (128 64 3)))
        (val s3-r5-rp (@undef-params _ (64 128 1)))
        (val s3-r5-ep (@undef-params _ (128 64 3)))
        (val s3-r6-rp (@undef-params _ (64 128 1)))
        (val s3-r6-ep (@undef-params _ (128 64 3)))
        (val s3-r7-rp (@undef-params _ (64 128 1)))
        (val s3-r7-ep (@undef-params _ (128 64 3)))
        (val s3-r8-rp (@undef-params _ (64 128 1)))
        (val s3-r8-ep (@undef-params _ (128 64 3)))
        (val s3-mf-p (@undef-params _ (128 128 1)))
        (val s3-tr-p (@undef-params _ (256 256 1)))
        (val (s3 : *f256x76)
             (@csp-stage-x8 _ (128 128 64 75) s2
               s3-down-p s3-skip-p s3-m0-p s3-r1-rp s3-r1-ep s3-r2-rp s3-r2-ep s3-r3-rp s3-r3-ep s3-r4-rp s3-r4-ep
               s3-r5-rp s3-r5-ep s3-r6-rp s3-r6-ep s3-r7-rp s3-r7-ep s3-r8-rp s3-r8-ep s3-mf-p s3-tr-p))

        ;; --- s4: CSP x8, 76 -> 38, 256 -> 512 channels (feeds P4) ---
        (val s4-down-p (@undef-params _ (512 256 3)))
        (val s4-skip-p (@undef-params _ (256 512 1)))
        (val s4-m0-p (@undef-params _ (256 512 1)))
        (val s4-r1-rp (@undef-params _ (128 256 1)))
        (val s4-r1-ep (@undef-params _ (256 128 3)))
        (val s4-r2-rp (@undef-params _ (128 256 1)))
        (val s4-r2-ep (@undef-params _ (256 128 3)))
        (val s4-r3-rp (@undef-params _ (128 256 1)))
        (val s4-r3-ep (@undef-params _ (256 128 3)))
        (val s4-r4-rp (@undef-params _ (128 256 1)))
        (val s4-r4-ep (@undef-params _ (256 128 3)))
        (val s4-r5-rp (@undef-params _ (128 256 1)))
        (val s4-r5-ep (@undef-params _ (256 128 3)))
        (val s4-r6-rp (@undef-params _ (128 256 1)))
        (val s4-r6-ep (@undef-params _ (256 128 3)))
        (val s4-r7-rp (@undef-params _ (128 256 1)))
        (val s4-r7-ep (@undef-params _ (256 128 3)))
        (val s4-r8-rp (@undef-params _ (128 256 1)))
        (val s4-r8-ep (@undef-params _ (256 128 3)))
        (val s4-mf-p (@undef-params _ (256 256 1)))
        (val s4-tr-p (@undef-params _ (512 512 1)))
        (val (s4 : *f512x38)
             (@csp-stage-x8 _ (256 256 128 37) s3
               s4-down-p s4-skip-p s4-m0-p s4-r1-rp s4-r1-ep s4-r2-rp s4-r2-ep s4-r3-rp s4-r3-ep s4-r4-rp s4-r4-ep
               s4-r5-rp s4-r5-ep s4-r6-rp s4-r6-ep s4-r7-rp s4-r7-ep s4-r8-rp s4-r8-ep s4-mf-p s4-tr-p))

        ;; --- s5: CSP x4, 38 -> 19, 512 -> 1024 channels ---
        (val s5-down-p (@undef-params _ (1024 512 3)))
        (val s5-skip-p (@undef-params _ (512 1024 1)))
        (val s5-m0-p (@undef-params _ (512 1024 1)))
        (val s5-r1-rp (@undef-params _ (256 512 1)))
        (val s5-r1-ep (@undef-params _ (512 256 3)))
        (val s5-r2-rp (@undef-params _ (256 512 1)))
        (val s5-r2-ep (@undef-params _ (512 256 3)))
        (val s5-r3-rp (@undef-params _ (256 512 1)))
        (val s5-r3-ep (@undef-params _ (512 256 3)))
        (val s5-r4-rp (@undef-params _ (256 512 1)))
        (val s5-r4-ep (@undef-params _ (512 256 3)))
        (val s5-mf-p (@undef-params _ (512 512 1)))
        (val s5-tr-p (@undef-params _ (1024 1024 1)))
        (val (s5 : *f1024x19)
             (@csp-stage-x4 _ (512 512 256 18) s4
               s5-down-p s5-skip-p s5-m0-p s5-r1-rp s5-r1-ep s5-r2-rp s5-r2-ep s5-r3-rp s5-r3-ep s5-r4-rp s5-r4-ep
               s5-mf-p s5-tr-p))

        ;; --- pre-SPP 3-conv block, then SPP (maxpool 5/9/13 + concat) ---
        (val pspp-c1-p (@undef-params _ (512 1024 1)))
        (val pspp-c2-p (@undef-params _ (1024 512 3)))
        (val pspp-c3-p (@undef-params _ (512 1024 1)))
        (val (pre-spp : *f512x19)
             (@panet-3conv _ (1024 1024 512 19) s5 pspp-c1-p pspp-c2-p pspp-c3-p))
        (val (spp-out : [Float 2048 19 19]) (@spp _ (19 512) pre-spp))

        ;; --- post-SPP 3-conv block: 2048 -> 512 channels, becomes the P5 trunk ---
        (val post-c1-p (@undef-params _ (512 2048 1)))
        (val post-c2-p (@undef-params _ (1024 512 3)))
        (val post-c3-p (@undef-params _ (512 1024 1)))
        (val (p5 : *f512x19)
             (@panet-3conv _ (2048 1024 512 19) spp-out post-c1-p post-c2-p post-c3-p))

        ;; --- PANet top-down 19 -> 38: reduce P5, upsample, lateral from s4, concat ---
        (val p5r-p (@undef-params _ (256 512 1)))
        (val s4l-p (@undef-params _ (256 512 1)))
        (val (p5-reduce : [Float 256 19 19]) (@conv-bn-leaky _ (18 1 512 256 0 1 0) p5 p5r-p))
        (val (p5-up : *f256x38) (@upsample-nearest _ (19 256 2) p5-reduce))
        (val (s4-lateral : *f256x38) (@conv-bn-leaky _ (37 1 512 256 0 1 0) s4 s4l-p))
        (val (merge-38 : *f512x38) (@route2 _ (256 256 38 38) p5-up s4-lateral))

        ;; --- PANet top-down 5-conv block at 38x38 ---
        (val p4td-c1-p (@undef-params _ (256 512 1)))
        (val p4td-c2-p (@undef-params _ (512 256 3)))
        (val p4td-c3-p (@undef-params _ (256 512 1)))
        (val p4td-c4-p (@undef-params _ (512 256 3)))
        (val p4td-c5-p (@undef-params _ (256 512 1)))
        (val (p4td : *f256x38)
             (@panet-5conv _ (512 256 38) merge-38
               p4td-c1-p p4td-c2-p p4td-c3-p p4td-c4-p p4td-c5-p))

        ;; --- PANet top-down 38 -> 76: reduce, upsample, lateral from s3, concat ---
        (val p4tdr-p (@undef-params _ (128 256 1)))
        (val s3l-p (@undef-params _ (128 256 1)))
        (val (p4td-reduce : [Float 128 38 38]) (@conv-bn-leaky _ (37 1 256 128 0 1 0) p4td p4tdr-p))
        (val (p4td-up : *f128x76) (@upsample-nearest _ (38 128 2) p4td-reduce))
        (val (s3-lateral : *f128x76) (@conv-bn-leaky _ (75 1 256 128 0 1 0) s3 s3l-p))
        (val (merge-76 : *f256x76) (@route2 _ (128 128 76 76) p4td-up s3-lateral))

        ;; --- P3 output: 5-conv block at 76x76 -> 128 channels ---
        (val p3o-c1-p (@undef-params _ (128 256 1)))
        (val p3o-c2-p (@undef-params _ (256 128 3)))
        (val p3o-c3-p (@undef-params _ (128 256 1)))
        (val p3o-c4-p (@undef-params _ (256 128 3)))
        (val p3o-c5-p (@undef-params _ (128 256 1)))
        (val (p3out : *f128x76)
             (@panet-5conv _ (256 128 76) merge-76
               p3o-c1-p p3o-c2-p p3o-c3-p p3o-c4-p p3o-c5-p))

        ;; --- PANet bottom-up 76 -> 38: downsample P3 (3x3/s2), concat with top-down P4 ---
        (val p3d-p (@undef-params _ (256 128 3)))
        (val (p3-down : *f256x38) (@conv-bn-leaky _ (37 3 128 256 1 2 1) p3out p3d-p))
        (val (merge-38b : *f512x38) (@route2 _ (256 256 38 38) p3-down p4td))

        ;; --- P4 output: 5-conv block at 38x38 -> 256 channels ---
        (val p4o-c1-p (@undef-params _ (256 512 1)))
        (val p4o-c2-p (@undef-params _ (512 256 3)))
        (val p4o-c3-p (@undef-params _ (256 512 1)))
        (val p4o-c4-p (@undef-params _ (512 256 3)))
        (val p4o-c5-p (@undef-params _ (256 512 1)))
        (val (p4out : *f256x38)
             (@panet-5conv _ (512 256 38) merge-38b
               p4o-c1-p p4o-c2-p p4o-c3-p p4o-c4-p p4o-c5-p))

        ;; --- PANet bottom-up 38 -> 19: downsample P4 (3x3/s2), concat with P5 trunk ---
        (val p4od-p (@undef-params _ (512 256 3)))
        (val (p4out-down : *f512x19) (@conv-bn-leaky _ (18 3 256 512 1 2 1) p4out p4od-p))
        (val (merge-19 : *f1024x19) (@route2 _ (512 512 19 19) p4out-down p5))

        ;; --- P5 output: 5-conv block at 19x19 -> 512 channels ---
        (val p5o-c1-p (@undef-params _ (512 1024 1)))
        (val p5o-c2-p (@undef-params _ (1024 512 3)))
        (val p5o-c3-p (@undef-params _ (512 1024 1)))
        (val p5o-c4-p (@undef-params _ (1024 512 3)))
        (val p5o-c5-p (@undef-params _ (512 1024 1)))
        (val (p5out : *f512x19)
             (@panet-5conv _ (1024 512 19) merge-19
               p5o-c1-p p5o-c2-p p5o-c3-p p5o-c4-p p5o-c5-p))
       )
    [(@full-sum _ (76 128) p3out) (@full-sum _ (38 256) p4out) (@full-sum _ (19 512) p5out)]))
