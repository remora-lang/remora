    (@uw _ (256 256 1)) (@u1 _ (256)) (@u1 _ (256)) (@u1 _ (256)) (@u1 _ (256))  ;; s3-tr: transition 1x1 after concat

    ;; --- s4: CSP x8, 76 -> 38, 256 -> 512 channels (feeds P4) ---
