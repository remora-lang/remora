    (@uw _ (32 16 3)) (@u1 _ (32)) (@u1 _ (32)) (@u1 _ (32)) (@u1 _ (32))  ;; s1-r1-e: res block 1: 3x3 expand
    (@uw _ (32 32 1)) (@u1 _ (32)) (@u1 _ (32)) (@u1 _ (32)) (@u1 _ (32))  ;; s1-mf: main path final 1x1
    (@uw _ (64 64 1)) (@u1 _ (64)) (@u1 _ (64)) (@u1 _ (64)) (@u1 _ (64))  ;; s1-tr: transition 1x1 after concat

    ;; --- s2: CSP x2, 304 -> 152, 64 -> 128 channels ---
    (@uw _ (128 64 2)) (@u1 _ (128)) (@u1 _ (128)) (@u1 _ (128)) (@u1 _ (128))  ;; s2-down: 2x2/2 downsample
    (@uw _ (64 128 1)) (@u1 _ (64)) (@u1 _ (64)) (@u1 _ (64)) (@u1 _ (64))  ;; s2-skip: CSP skip path 1x1
    (@uw _ (64 128 1)) (@u1 _ (64)) (@u1 _ (64)) (@u1 _ (64)) (@u1 _ (64))  ;; s2-m0: CSP main path 1x1
    (@uw _ (32 64 1)) (@u1 _ (32)) (@u1 _ (32)) (@u1 _ (32)) (@u1 _ (32))  ;; s2-r1-r: res block 1: 1x1 reduce
    (@uw _ (64 32 3)) (@u1 _ (64)) (@u1 _ (64)) (@u1 _ (64)) (@u1 _ (64))  ;; s2-r1-e: res block 1: 3x3 expand
