;; ----------------- UTILITIES -------------------------
(def (fun (@replicate (&t) (@f @s) (in [&t @s]) : [&t @f @s])
    ((array [] (fn ((x [Int])) in)) (i-app iota/static @f))))

;; ----------------- 4D TRANSPOSE (axes 0 1 2 3 -> 0 2 1 3) -------------------------

;; Swaps the middle two axes of a rank-4 array, leaving the outermost and
;; innermost axes fixed: out[i][k][j][l] = in[i][j][k][l].
;;
;; @transpose2d only ever swaps the trailing two axes of whatever it's
;; applied to (any leading axes just become a lifted frame), so axes 1 and 2
;; can't be hit directly. Route around that with flatten/reshape: merge
;; (c,d) into one axis, transpose (b,cd) -> (cd,b), split cd back into
;; (c,d), then transpose the new trailing (d,b) -> (b,d).
(def (fun (@transpose4d/0213 (&t) ($a $b $c $d)
                (in [&t $a $b $c $d])
                : [&t $a $c $b $d])
    (let ((val (flat-cd : [&t $a $b (* $c $d)])
               (@flatten (&t) ($c $d []) in))
          (val (swapped : [&t $a (* $c $d) $b])
               (@transpose2d (&t) ($b (* $c $d)) flat-cd))
          (val (split-cd : [&t $a $c $d $b])
               (@reshape (&t) ([$a (* $c $d) $b] [$a $c $d $b]) swapped)))
      (@transpose2d (&t) ($d $b) split-cd))))

;; ----------------- NEAREST NEIGHBOR UPSAMPLING -------------------------

;; $s is the upsample stride/factor; each input pixel is replicated into an
;; $s x $s block in the output (matching darknet's upsample_layer).
;;
;; Approach: replicate each scalar cell into an [$s $s] block (giving shape
;; [$k $n $n $s $s], one block per input pixel), then use @transpose4d/0213
;; (lifted over the channel axis $k) to interleave each row-replication axis
;; next to its source axis: [$k $n $n $s $s] -> [$k $n $s $n $s]. Flattening
;; each adjacent (position, replication) pair then merges them into the
;; final upsampled spatial axes.
(def (fun (@upsample-nearest _ ($n $k $s)
                (in [Float $k $n $n])
                : [Float $k (* $n $s) (* $n $s)])
    (let ((val (replicated : [Float $k $n $n $s $s])
               (@replicate (Float) ([$s $s] []) in))
          (val (transposed : [Float $k $n $s $n $s])
               (@transpose4d/0213 (Float) ($n $n $s $s) replicated))
          (val (merged-rows : [Float $k (* $n $s) $n $s])
               (@flatten (Float) ($n $s [$n $s]) transposed)))
      (@flatten (Float) ($n $s []) merged-rows))))

;; 2x upsample of a 2-channel 2x2 image -> 4x4 per channel, each pixel
;; repeated into a 2x2 block; channels stay separate.
;; Expected output:
;; [[[1  1  2  2]
;;   [1  1  2  2]
;;   [3  3  4  4]
;;   [3  3  4  4]]
;;  [[10 10 20 20]
;;   [10 10 20 20]
;;   [30 30 40 40]
;;   [30 30 40 40]]]
(entry (main)
  (@upsample-nearest _ (2 2 2)
    [[[1.0  2.0]
      [3.0  4.0]]
     [[10.0 20.0]
      [30.0 40.0]]]))
