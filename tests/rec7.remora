;; ==
;; input { [1.0 2.0] [10.0 20.0] [3.0] [30.0] }
;; output { [1.0 2.0 3.0] }

;; ==
;; entry: lifted
;; input { [1.0 2.0] 9.0 }
;; output { [9.0 9.0] }

(entry (main (a [Float 2]) (b [Float 2]) (c [Float 1]) (d [Float 1]))
  (let ((type &pair {(u [Float]) (v [Float])})
        (val (xs : [&pair 2]) {(u [] a) (v [] b)})
        (val (ys : [&pair 1]) {(u [] c) (v [] d)}))
    (field (@append (&pair) (2 1 []) xs ys) u)))

(entry (lifted (a [Float 2]) (s Float))
  (field {(u [] a) (v [] s)} v))
